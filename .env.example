# Copy this file to .env and fill in the values. .env is ignored by git and by Docker builds.

# Production only (compose.prod.yml): your domain, without https://
DOMAIN=

# AI assistant on/off (true / false). Off = the "Ask about me" button disappears.
ASSISTANT_ENABLED=true

# Required for the assistant: your Claude API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Optional (defaults shown)
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
RATE_PER_MINUTE=8
RATE_PER_DAY=40
RATE_GLOBAL_PER_DAY=500
LOG_QUESTIONS=false
# How often GitHub repositories are re-read for the Lab (e.g. 30m, 1h, 24h). A restart always refreshes.
GITHUB_REFRESH=24h
# Port published on your machine
HOST_PORT=8787
